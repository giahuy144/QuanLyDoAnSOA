@model IEnumerable<WebClient.Models.DeTaiViewModel>
@{
    ViewData["Title"] = "Quản lý Đề Tài";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="fw-bold text-primary"><i class="bi bi-journal-bookmark-fill me-2"></i>Danh Sách Đề Tài Đồ Án</h3>
    <a asp-action="Create" class="btn btn-success"><i class="bi bi-plus-circle me-1"></i>Thêm Đề Tài</a>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover table-striped align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th style="width: 100px;">Mã ĐT</th>
                        <th>Tên Đề Tài</th>
                        <th>Giảng Viên Hướng Dẫn</th>
                        <th class="text-center" style="width: 130px;">Chỉ Tiêu Tối Đa</th>
                        <th class="text-center" style="width: 160px;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="fw-bold">@item.MaDT</td>
                                <td>
                                    <div class="fw-semibold">@item.TenDT</div>
                                    <small class="text-muted">@item.MoTa</small>
                                </td>
                                <td>@item.GiangVienHD</td>
                                <td class="text-center">
                                    <span class="badge bg-info text-dark fs-6">@item.SoLuongToiDa SV</span>
                                </td>
                                <td class="text-center">
                                    <a asp-action="Edit" asp-route-id="@item.MaDT" class="btn btn-sm btn-outline-primary me-1">
                                        <i class="bi bi-pencil"></i> Sửa
                                    </a>
                                    <form asp-action="Delete" asp-route-id="@item.MaDT" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc muốn xóa đề tài @item.MaDT không?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger">
                                            <i class="bi bi-trash"></i> Xóa
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center py-4 text-muted">Chưa có đề tài nào trong hệ thống.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
