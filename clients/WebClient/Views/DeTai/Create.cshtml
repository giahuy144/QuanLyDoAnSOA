@model WebClient.Models.DeTaiViewModel
@{
    ViewData["Title"] = "Thêm Đề Tài Mới";
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-success text-white fw-bold">
                <i class="bi bi-journal-plus me-2"></i>Thêm Đề Tài Mới
            </div>
            <div class="card-body">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="MaDT" class="form-label fw-bold"></label>
                        <input asp-for="MaDT" class="form-control" placeholder="Ví dụ: DT05" />
                        <span asp-validation-for="MaDT" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="TenDT" class="form-label fw-bold"></label>
                        <input asp-for="TenDT" class="form-control" placeholder="Tên đề tài nghiên cứu hoặc ứng dụng" />
                        <span asp-validation-for="TenDT" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="MoTa" class="form-label fw-bold"></label>
                        <textarea asp-for="MoTa" rows="3" class="form-control" placeholder="Mô tả tóm tắt nội dung và yêu cầu công nghệ"></textarea>
                        <span asp-validation-for="MoTa" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="GiangVienHD" class="form-label fw-bold"></label>
                        <input asp-for="GiangVienHD" class="form-control" placeholder="Học hàm, học vị và họ tên giảng viên" />
                        <span asp-validation-for="GiangVienHD" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="SoLuongToiDa" class="form-label fw-bold"></label>
                        <input asp-for="SoLuongToiDa" type="number" min="1" max="10" class="form-control" />
                        <span asp-validation-for="SoLuongToiDa" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-between mt-4">
                        <a asp-action="Index" class="btn btn-secondary"><i class="bi bi-arrow-left me-1"></i>Quay lại</a>
                        <button type="submit" class="btn btn-success"><i class="bi bi-save me-1"></i>Lưu Đề Tài</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
