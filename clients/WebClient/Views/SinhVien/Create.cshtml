@model WebClient.Models.SinhVienViewModel
@{
    ViewData["Title"] = "Thêm Sinh Viên Mới";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-success text-white fw-bold">
                <i class="bi bi-person-plus-fill me-2"></i>Thêm Sinh Viên Mới
            </div>
            <div class="card-body">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="MaSV" class="form-label fw-bold"></label>
                        <input asp-for="MaSV" class="form-control" placeholder="Ví dụ: SV005" />
                        <span asp-validation-for="MaSV" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="HoTen" class="form-label fw-bold"></label>
                        <input asp-for="HoTen" class="form-control" placeholder="Ví dụ: Nguyễn Văn A" />
                        <span asp-validation-for="HoTen" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Lop" class="form-label fw-bold"></label>
                        <input asp-for="Lop" class="form-control" placeholder="Ví dụ: CNTT1" />
                        <span asp-validation-for="Lop" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-bold"></label>
                        <input asp-for="Email" type="email" class="form-control" placeholder="Ví dụ: a.nv@university.edu.vn" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="SoDienThoai" class="form-label fw-bold"></label>
                        <input asp-for="SoDienThoai" class="form-control" placeholder="Ví dụ: 0912345678" />
                        <span asp-validation-for="SoDienThoai" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-between mt-4">
                        <a asp-action="Index" class="btn btn-secondary"><i class="bi bi-arrow-left me-1"></i>Quay lại</a>
                        <button type="submit" class="btn btn-success"><i class="bi bi-save me-1"></i>Lưu Sinh Viên</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
