@model IEnumerable<WebClient.Models.SinhVienViewModel>
@{
    ViewData["Title"] = "Quản lý Sinh Viên";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="fw-bold text-primary"><i class="bi bi-people-fill me-2"></i>Danh Sách Sinh Viên</h3>
    <a asp-action="Create" class="btn btn-success"><i class="bi bi-plus-circle me-1"></i>Thêm Sinh Viên</a>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover table-striped align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Mã SV</th>
                        <th>Họ và Tên</th>
                        <th>Lớp</th>
                        <th>Email</th>
                        <th>Số Điện Thoại</th>
                        <th class="text-center" style="width: 160px;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="fw-bold">@item.MaSV</td>
                                <td>@item.HoTen</td>
                                <td><span class="badge bg-secondary">@item.Lop</span></td>
                                <td>@item.Email</td>
                                <td>@item.SoDienThoai</td>
                                <td class="text-center">
                                    <a asp-action="Edit" asp-route-id="@item.MaSV" class="btn btn-sm btn-outline-primary me-1">
                                        <i class="bi bi-pencil"></i> Sửa
                                    </a>
                                    <form asp-action="Delete" asp-route-id="@item.MaSV" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc muốn xóa sinh viên @item.MaSV không?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger">
                                            <i class="bi bi-trash"></i> Xóa
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-4 text-muted">Chưa có sinh viên nào trong hệ thống.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
