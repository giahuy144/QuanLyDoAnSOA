@{
    ViewData["Title"] = "Từ Chối Truy Cập";
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="card shadow-sm border-0 border-top border-4 border-danger">
            <div class="card-body text-center py-5">
                <i class="bi bi-shield-lock-fill text-danger" style="font-size: 4rem;"></i>
                <h3 class="fw-bold text-danger mt-3">403 &mdash; Không có quyền truy cập</h3>
                <p class="text-muted mb-1">
                    Tài khoản của bạn <strong>không được phép</strong> sử dụng chức năng này.
                </p>
                <p class="small text-secondary">
                    Sinh viên chỉ được phép <strong>đăng ký đồ án</strong>. Các chức năng quản lý
                    (Sinh viên, Đề tài, Hủy đăng ký) dành riêng cho <strong>Giáo viên</strong>.
                </p>
                <div class="d-flex justify-content-center gap-2 mt-4">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">
                        <i class="bi bi-house me-1"></i>Về Trang chủ
                    </a>
                    <a asp-controller="DangKy" asp-action="Index" class="btn btn-success">
                        <i class="bi bi-card-checklist me-1"></i>Đăng Ký Đồ Án
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
