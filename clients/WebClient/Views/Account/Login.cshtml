@model WebClient.Models.LoginViewModel
@{
    ViewData["Title"] = "Đăng Nhập";
}

<div class="row justify-content-center">
    <div class="col-md-5">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-primary text-white fw-bold">
                <i class="bi bi-box-arrow-in-right me-2"></i>Đăng Nhập Hệ Thống
            </div>
            <div class="card-body">
                <form asp-action="Login" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="ReturnUrl" />
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Username" class="form-label fw-bold"></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-person-fill"></i></span>
                            <input asp-for="Username" class="form-control" placeholder="Nhập tên đăng nhập" autofocus />
                        </div>
                        <span asp-validation-for="Username" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label fw-bold"></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-lock-fill"></i></span>
                            <input asp-for="Password" class="form-control" placeholder="Nhập mật khẩu" />
                        </div>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="form-check mb-3">
                        <input asp-for="RememberMe" class="form-check-input" />
                        <label asp-for="RememberMe" class="form-check-label"></label>
                    </div>

                    <button type="submit" class="btn btn-primary w-100">
                        <i class="bi bi-box-arrow-in-right me-1"></i>Đăng Nhập
                    </button>
                </form>

                <hr />
                <p class="text-center mb-0">
                    Chưa có tài khoản?
                    <a asp-action="Register" class="fw-bold">Đăng ký ngay</a>
                </p>
            </div>
        </div>

        <div class="alert alert-secondary small mt-3">
            <i class="bi bi-info-circle-fill me-1"></i>
            <strong>Tài khoản demo (mật khẩu: <code>123456</code>)</strong>
            <div class="mt-1">
                <span class="badge bg-danger">Giáo viên</span> <code>giaovien1</code> &mdash; TS. Trần Văn Hùng (toàn quyền)
            </div>
            <div>
                <span class="badge bg-success">Sinh viên</span> <code>sinhvien1</code> &mdash; Nguyễn Văn An (chỉ đăng ký đồ án)
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
